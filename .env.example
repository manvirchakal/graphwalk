# Copy to .env and fill in. Never commit .env.

# Decision backend (Jev): "openrouter" or "typesafe"
GRAPHWALK_DECISION_PROVIDER=openrouter

# Key for the selected provider
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Pinned model ids (defaults shown; never use jev-latest)
# GRAPHWALK_JEV_MODEL_OPENROUTER=typesafe/jev-1.13
# GRAPHWALK_JEV_MODEL_TYPESAFE=jev-1.13.0

# Optional base-URL overrides (e.g. a gateway or proxy). Defaults shown.
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# TYPESAFE_BASE_URL=https://api.typesafe.ai
