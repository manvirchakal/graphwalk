# Copy to .env and fill in what you use. Never commit .env.
# Real environment variables override this file; explicit arguments override both.

# --- Keys (set only the providers you use) ------------------------------------------
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# --- Base-URL overrides (gateways, proxies). Defaults shown; SDK conventions. --------
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# XAI_BASE_URL=https://api.x.ai/v1

# --- Decision role: which decider walks (docs/deciders.md) ------------------------------
# GRAPHWALK_DECIDER=jev                    # jev | logprob | llm
# Jev, via openrouter or typesafe:
GRAPHWALK_DECISION_PROVIDER=openrouter
# Pinned model ids (never use jev-latest):
# GRAPHWALK_JEV_MODEL_OPENROUTER=typesafe/jev-1.13
# GRAPHWALK_JEV_MODEL_TYPESAFE=jev-1.13.0
# logprob: token probabilities from any OpenAI-compatible endpoint (default OpenRouter):
# GRAPHWALK_DECIDER_MODEL=qwen/qwen3.8-27b
# GRAPHWALK_DECIDER_BASE_URL=http://localhost:8000/v1
# GRAPHWALK_DECIDER_API_KEY=
# GRAPHWALK_DECIDER_MAX_RPM=
# With jev and no Jev key, decide with another decider instead:
# GRAPHWALK_DECISION_FALLBACK=logprob      # off | logprob | llm
# Escalated walks: llm (stated scores) or logprob (probabilities):
# GRAPHWALK_ESCALATION_DECIDER=llm

# --- LLM role (extraction, escalation, the fallback decider) ----------------------------
# GRAPHWALK_LLM_PROVIDER=openrouter        # openrouter | openai | anthropic | xai
# GRAPHWALK_LLM_MODEL=                     # default per provider; required for xai
# GRAPHWALK_ESCALATION_MODEL=

# --- Embedding role ---------------------------------------------------------------------
# GRAPHWALK_EMBEDDING_PROVIDER=fastembed   # fastembed (local) | openai | openrouter
# GRAPHWALK_EMBEDDING_MODEL=
